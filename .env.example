# ── KRX 정보데이터시스템 로그인 (필수) ──
# https://data.krx.co.kr 에서 회원가입 후 ID/비밀번호 입력
KRX_MBR_ID=
KRX_PW=

# ── DART API 키 (선택) ──
# https://opendart.fss.or.kr/ 에서 무료 발급
DART_API_KEY=

# ── KRX Open API 인증키 (선택) ──
# https://openapi.krx.co.kr 에서 발급 (관리자 승인 필요)
# KRX 로그인 장애 시 대체 데이터 소스로 사용
KRX_OPENAPI_AUTH_KEY=
